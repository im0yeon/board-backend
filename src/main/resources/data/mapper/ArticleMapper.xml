<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.imooyoni.board.data.mapper.ArticleMapper">

    <resultMap id="articleElements" type="com.imooyoni.board.data.domain.article.ArticleElements">
        <constructor>
            <idArg column="id" javaType="_long"/>
            <arg column="title" javaType="string"/>
            <arg column="writer" javaType="string"/>
            <arg column="is_notice" javaType="_boolean"/>
            <arg column="created_at" javaType="java.time.LocalDateTime"/>
        </constructor>
    </resultMap>

    <resultMap id="articleDetailElements" type="com.imooyoni.board.data.domain.article.ArticleDetailElements">
        <constructor>
            <idArg column="id" javaType="_long"/>
            <arg column="title" javaType="string"/>
            <arg column="content" javaType="string"/>
            <arg column="writer" javaType="string"/>
            <arg column="is_notice" javaType="_boolean"/>
            <arg column="file_url" javaType="string"/>
            <arg column="created_at" javaType="java.time.LocalDateTime"/>
        </constructor>
    </resultMap>

    <sql id="searchCondition">
        <where>
            <if test="cond.keyword != null">
                AND a.title LIKE CONCAT('%', #{cond.keyword}, '%')
            </if>
            <if test="cond.writer != null">
                AND a.writer LIKE CONCAT('%', #{cond.writer}, '%')
            </if>
            <if test="cond.startDateTime != null">
                AND a.created_at &gt;= #{cond.startDateTime}
            </if>
            <if test="cond.endDateTime != null">
                AND a.created_at &lt; #{cond.endDateTime}
            </if>
        </where>
    </sql>

    <select id="search" resultMap="articleElements">
        SELECT
            a.id,
            a.title,
            a.writer,
            (a.notice_yn = 'Y') AS is_notice,
            a.created_at
        FROM article a
        <include refid="searchCondition"/>
        ORDER BY a.id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countBy" resultType="_long">
        SELECT COUNT(*)
        FROM article a
        <include refid="searchCondition"/>
    </select>

    <select id="findDetailById" resultMap="articleDetailElements">
        SELECT
            a.id,
            a.title,
            a.content,
            a.writer,
            (a.notice_yn = 'Y') AS is_notice,
            a.file_url,
            a.created_at
        FROM article a
        WHERE a.id = #{id}
    </select>
</mapper>
